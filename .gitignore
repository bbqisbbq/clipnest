# ── 构建产物 ─────────────────────────────────────────────
# 根目录别再放构建产物：go build 不带 -o 会在这里掉一个 clipnest.exe
/*.exe
/bin/
/frontend/dist/
/frontend/node_modules/
# wails3 task runner 的校验和/时间戳状态（每台机器自己生成）
/.task/
# vditor 运行时资源：由 scripts/sync-vditor.ps1 从 node_modules 拷到 public（22MB 拷贝，不入库）
/frontend/public/vditor
# wails3 生成绑定时产生的临时目录
/frontend/.bindings-tmp-*/

# Wails 打包中间产物
/build/linux/appimage/build/
/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# 移动端生成物（每台机器的覆盖层里带绝对路径）
/build/ios/xcode/overlay.json
/build/ios/xcode/gen/
/build/android/overlay.json
/build/android/gen/

# 签名用的自签名证书与私钥（绝不入库）
/build/signing/

# ── 本机数据：绝不该进仓库 ───────────────────────────────
# 沙箱 APPDATA（e2e 脚本自己建，含 WebView2 缓存与真实条目）
/scratch/appdata-*/
/scratch/tmp-profile-*/
/scratch/tmp-*/
# 升级/迁移前的真实数据备份、故障恢复留档
/scratch/backup-*/
/scratch/recovered-*/
# 抓下来的远端包样本、本地 WebDAV 测试目录
/scratch/*.zip
/scratch/davroot/
# PP-OCR 引擎资产（onnxruntime.dll + 约 21MB 模型，本地下载）
/scratch/ppocr-assets/

# ── 本机看效果用的截图与快照（脚本入库，产物不入库）──────
/scratch/*.png
/scratch/*.exe
/scratch/*-shots/
/scratch/ui-review/*.png
/scratch/ui-review/dist-before.css
/scratch/layout-preview/*.png
/scratch/ocr-shots/
/scratch/ocr-spike/out.txt
/scratch/probe.txt
# 脚本调试时误落的 stderr 日志
*.err.log

