Unicode true

####
## ClipNest installer (NSIS).
##
## Template defines live in wails_tools.nsh (generated by `wails3 package`); the
## names below are only defaults for standalone makensis runs.
##
## Build via:  wails3 package            (machine scope, needs UAC)
##             wails3 package INSTALL_SCOPE=user   (per-user, no UAC)
####
!include "wails_tools.nsh"

# The version information for this two must consist of 4 parts
VIProductVersion "${INFO_PRODUCTVERSION}.0"
VIFileVersion    "${INFO_PRODUCTVERSION}.0"

VIAddVersionKey "CompanyName"     "${INFO_COMPANYNAME}"
VIAddVersionKey "FileDescription" "${INFO_PRODUCTNAME} 安装程序"
VIAddVersionKey "ProductVersion"  "${INFO_PRODUCTVERSION}"
VIAddVersionKey "FileVersion"     "${INFO_PRODUCTVERSION}"
VIAddVersionKey "LegalCopyright"  "${INFO_COPYRIGHT}"
VIAddVersionKey "ProductName"     "${INFO_PRODUCTNAME}"

# Enable HiDPI support. https://nsis.sourceforge.io/Reference/ManifestDPIAware
ManifestDPIAware true

!include "MUI.nsh"

!define MUI_ICON "..\icon.ico"
!define MUI_UNICON "..\icon.ico"
!define MUI_ABORTWARNING

## Finish page: offer to start the app right away.
!define MUI_FINISHPAGE_RUN "$INSTDIR\${PRODUCT_EXECUTABLE}"
!define MUI_FINISHPAGE_RUN_TEXT "立即启动 ${INFO_PRODUCTNAME}（驻留系统托盘）"
!define MUI_FINISHPAGE_NOREBOOTSUPPORT

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "SimpChinese"

## Signing hooks (uncomment and point at your certificate tooling):
#!uninstfinalize 'signtool sign /fd sha256 /f "cert.pfx" /t http://timestamp.digicert.com "%1"'
#!finalize 'signtool sign /fd sha256 /f "cert.pfx" /t http://timestamp.digicert.com "%1"'

Name "${INFO_PRODUCTNAME}"
OutFile "..\..\..\bin\${INFO_PROJECTNAME}-${ARCH}-installer.exe"

!if "${WAILS_INSTALL_SCOPE}" == "user"
    InstallDir "$LOCALAPPDATA\Programs\${INFO_PRODUCTNAME}"
!else
    InstallDir "$PROGRAMFILES64\${INFO_COMPANYNAME}\${INFO_PRODUCTNAME}"
!endif

ShowInstDetails show

Function .onInit
   !insertmacro wails.checkArchitecture

   # 安装前先收掉正在运行的 ClipNest：否则 exe 被占用，覆盖时会弹"重试/取消"，
   # 用户会以为装失败了。这里直接结束旧进程，装完由结束页的"运行"重新拉起。
   # taskkill 退出码：0 = 结束成功，128 = 没找到进程（说明本来就没在跑）
   nsExec::ExecToStack 'cmd /c taskkill /IM ${PRODUCT_EXECUTABLE} /T /F'
   Pop $0
   Pop $1
   ${If} $0 == 0
     Sleep 800
     DetailPrint "已结束正在运行的 ClipNest（安装完成后会重新启动）"
     ; 再补一刀：有时候主进程结束了，子进程还握着 exe
     nsExec::ExecToStack 'cmd /c taskkill /IM ${PRODUCT_EXECUTABLE} /T /F'
     Pop $0
     Pop $1
     Sleep 300
   ${EndIf}
FunctionEnd

!define AUTORUN_KEY "Software\Microsoft\Windows\CurrentVersion\Run"
!define AUTORUN_VALUE "ClipNest"

Section "ClipNest 主程序" SecMain
    SectionIn RO

    !insertmacro wails.setShellContext
    !insertmacro wails.webview2runtime

    SetOutPath $INSTDIR
    !insertmacro wails.files

    CreateShortcut "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    CreateShortCut "$DESKTOP\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"

    !insertmacro wails.associateFiles
    !insertmacro wails.associateCustomProtocols

    !insertmacro wails.writeUninstaller
SectionEnd

Section "开机自动启动（推荐）" SecAutoStart
    # HKCU Run: no admin rights needed, applies to the current user only.
    # --background keeps ClipNest in the tray instead of opening its window at logon.
    WriteRegStr HKCU "${AUTORUN_KEY}" "${AUTORUN_VALUE}" '"$INSTDIR\${PRODUCT_EXECUTABLE}" --background'
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
    !insertmacro MUI_DESCRIPTION_TEXT ${SecMain} "ClipNest 主程序，包含开始菜单与桌面快捷方式；缺失时会自动安装 WebView2 运行时。"
    !insertmacro MUI_DESCRIPTION_TEXT ${SecAutoStart} "登录 Windows 后自动运行并静默驻留托盘（不弹窗）。随时可以在托盘菜单或设置页关闭。"
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "uninstall"
    !insertmacro wails.setShellContext

    # Stop a running instance so files are not locked.
    ExecWait 'taskkill /IM "${PRODUCT_EXECUTABLE}" /F'

    DeleteRegValue HKCU "${AUTORUN_KEY}" "${AUTORUN_VALUE}"
    SetRegView 64
    DeleteRegValue HKCU "${AUTORUN_KEY}" "${AUTORUN_VALUE}"

    # Ask before touching the clipboard history: it is user data, not program files.
    # Unattended (/S) uninstalls keep the history: deleting user data silently is
    # the kind of thing that gets an installer blacklisted.
    IfSilent keepHistory
    IfFileExists "$APPDATA\ClipNest\*.*" 0 keepHistory
    MessageBox MB_YESNO|MB_ICONQUESTION \
        "是否同时删除剪贴板历史与设置？$\r$\n$\r$\n位置：$APPDATA\ClipNest$\r$\n$\r$\n选择「否」将保留，重新安装后可继续使用。" \
        IDNO keepHistory
    RMDir /r "$APPDATA\ClipNest"
    keepHistory:
    RMDir /r "$AppData\${PRODUCT_EXECUTABLE}" # WebView2 user data
    RMDir /r $INSTDIR

    Delete "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk"
    Delete "$DESKTOP\${INFO_PRODUCTNAME}.lnk"

    !insertmacro wails.unassociateFiles
    !insertmacro wails.unassociateCustomProtocols

    !insertmacro wails.deleteUninstaller
SectionEnd
