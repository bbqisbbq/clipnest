{
  "name": "clipnest-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "pwsh -NoProfile -File ../scripts/sync-vditor.ps1",
    "build:dev": "tsc && vite build --minify false --mode development",
    "prebuild:dev": "pwsh -NoProfile -File ../scripts/sync-vditor.ps1",
    "build": "tsc && vite build --mode production",
    "prebuild": "pwsh -NoProfile -File ../scripts/sync-vditor.ps1",
    "sync-vditor": "pwsh -NoProfile -File ../scripts/sync-vditor.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "marked": "^18.2.1",
    "mygo-runtime": "^0.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vditor": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.2.4"
  }
}

